{
  "schemaVersion": 1,
  "intents": {
    "confirm": {
      "narration": "nods in agreement and approval",
      "notification": "nods in agreement",
      "targetedNotification": "nods in agreement with {target}"
    },
    "deny": {
      "narration": "shakes their head in disagreement and disapproval",
      "notification": "shakes their head in disagreement",
      "targetedNotification": "shakes their head at {target} in disagreement"
    },
    "greet": {
      "narration": "gives a friendly wave in greeting",
      "notification": "greets",
      "targetedNotification": "greets {target}"
    },
    "farewell": {
      "narration": "waves goodbye",
      "notification": "waves goodbye",
      "targetedNotification": "waves goodbye to {target}"
    },
    "calm_down": {
      "narration": "slowly lowers both open hands, palms down, asking for calm",
      "notification": "gestures for calm",
      "targetedNotification": "gestures to {target} for calm"
    },
    "thanks": {
      "narration": "bows their head in thanks",
      "notification": "gives thanks",
      "targetedNotification": "gives thanks to {target}"
    },
    "sorry": {
      "narration": "makes an apologetic gesture",
      "notification": "apologizes",
      "targetedNotification": "apologizes to {target}"
    },
    "congratulate": {
      "narration": "applauds in congratulations",
      "notification": "congratulates",
      "targetedNotification": "congratulates {target}"
    },
    "offer": {
      "narration": "extends an open hand, offering to give something",
      "notification": "offers something",
      "targetedNotification": "offers something to {target}"
    },
    "ask": {
      "narration": "holds out an open hand, asking for something",
      "notification": "asks for something",
      "targetedNotification": "asks {target} for something"
    },
    "come_here": {
      "narration": "beckons for someone to come closer",
      "notification": "beckons",
      "targetedNotification": "beckons {target}"
    },
    "follow_me": {
      "narration": "gestures for others to follow them",
      "notification": "asks others to follow",
      "targetedNotification": "asks {target} to follow",
      "complianceNarration": "{target} complies and falls in behind {player}"
    },
    "wait_here": {
      "narration": "gestures for others to wait here",
      "notification": "asks others to wait",
      "targetedNotification": "asks {target} to wait",
      "complianceNarration": "{target} complies and stays put"
    },
    "dismiss": {
      "narration": "waves others off, releasing them from following",
      "notification": "dismisses others",
      "targetedNotification": "dismisses {target}",
      "complianceNarration": "{target} complies and stops following {player}"
    },
    "quiet": {
      "narration": "gestures for quiet",
      "notification": "asks for quiet",
      "targetedNotification": "asks {target} for quiet"
    },
    "warn": {
      "narration": "makes an urgent warning gesture",
      "notification": "gives a warning",
      "targetedNotification": "gives {target} a warning"
    },
    "unsure": {
      "narration": "shrugs, indicating uncertainty",
      "notification": "is unsure",
      "targetedNotification": "shrugs at {target}, indicating uncertainty"
    },
    "think": {
      "narration": "pauses thoughtfully, asking for a moment to think",
      "notification": "takes a moment to think",
      "targetedNotification": "asks {target} for a moment to think"
    },
    "not_understood": {
      "narration": "gives a puzzled look, indicating they do not understand",
      "notification": "does not understand",
      "targetedNotification": "gives {target} a puzzled look, indicating they do not understand"
    },
    "challenge": {
      "narration": "makes a challenging gesture",
      "notification": "issues a challenge",
      "targetedNotification": "makes a challenging gesture toward {target}"
    },
    "yield": {
      "narration": "raises their hands in surrender",
      "notification": "signals surrender",
      "targetedNotification": "signals surrender to {target}"
    },
    "understood": {
      "narration": "nods slowly, showing that they understand",
      "notification": "signals understanding",
      "targetedNotification": "nods to {target}, showing that they understand"
    },
    "comfort": {
      "narration": "offers a gentle, reassuring gesture",
      "notification": "offers comfort",
      "targetedNotification": "offers {target} a gentle, reassuring gesture"
    },
    "give_space": {
      "narration": "motions for others to step back and give them some space",
      "notification": "asks for space",
      "targetedNotification": "motions for {target} to step back and give them some space"
    }
  }
}
